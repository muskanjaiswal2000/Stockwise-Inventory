{
    "name": "Modules/inventory",
    "description": "Inventory module for the application",
    "type": "laravel-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Muskan Jaiswal",
            "email": "muskan.jaiswal@rcvtechnologies.com"
        }
    ],
    "require": {
        "php": "^8",
        "laravel/framework": "^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Inventory\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\Inventory\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Inventory\\Providers\\InventoryServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
} 